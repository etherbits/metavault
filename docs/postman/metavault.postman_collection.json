            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"/s\"\n}"
            },
            "url": "{{baseUrl}}/ezq"
          }
        },
        {
          "name": "POST /ezq Search By Tag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"/search tg:postman\"\n}"
            },
            "url": "{{baseUrl}}/ezq"
          }
        },
        {
          "name": "POST /ezq Update First Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"/update id:{{entryId}} > status:finished\"\n}"
            },
            "url": "{{baseUrl}}/ezq"
          }
        },
        {
          "name": "POST /ezq Delete First Entry",
          "request": {
            "method": "POST",
