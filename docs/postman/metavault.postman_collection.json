    {
      "name": "Catalogue",
      "description": "Global catalogue maintenance endpoints. POST /catalogue/refresh requires METAVAULT_CATALOGUE_REFRESH_KEY on the server to match the catalogueRefreshKey environment variable. The default refresh body uses refreshWindowMs 0 for quick local testing.",
      "item": [
        {
          "name": "POST /catalogue/refresh All Sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('catalogue refresh completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('completed');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.environment.set('catalogueFetchedCount', String(body.fetched_count || 0));",
                  "pm.environment.set('catalogueEmbeddedCount', String(body.embedded_count || 0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-metavault-catalogue-key",
                "value": "{{catalogueRefreshKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshWindowMs\": {{catalogueRefreshWindowMs}}\n}"
            },
            "url": "{{baseUrl}}/catalogue/refresh"
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "description": "Recommendation endpoints. Run Auth / Sign In Seeded User first, then Catalogue / POST /catalogue/refresh All Sources so there are embedded catalogue entries to rank.",
      "item": [
        {
          "name": "POST /recommendations/generate Cozy Anime",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('recommendations generated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().items).to.be.an('array');",
                  "});",
                  "",
                  "const items = pm.response.json().items || [];",
                  "if (items[0]) {",
                  "  pm.environment.set('recommendationItemId', items[0].catalogue_entry_id);",
                  "  pm.environment.set('recommendationTitle', items[0].title);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"{{recommendationPrompt}}\",\n  \"count\": {{recommendationCount}},\n  \"debug\": true,\n  \"filters\": {\n    \"adult\": \"exclude\",\n    \"excludeExistingLibrary\": false\n  }\n}"
            },
            "url": "{{baseUrl}}/recommendations/generate"
          }
        },
        {
          "name": "POST /recommendations/generate Reading Mood",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"I want something to read with adventure, emotion, and strong characters\",\n  \"count\": 5,\n  \"debug\": false,\n  \"filters\": {\n    \"adult\": \"exclude\",\n    \"excludedMediaTypes\": [\"anime\"],\n    \"excludeExistingLibrary\": false\n  }\n}"
            },
            "url": "{{baseUrl}}/recommendations/generate"
          }
        }
      ]
    },
