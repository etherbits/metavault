    {
      "name": "Library Import / Export",
      "item": [
        {
          "name": "POST /library Create Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created library entry', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "  pm.environment.set('libraryEntryId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman Library Entry",
                  "type": "text"
                },
                {
                  "key": "media_id",
                  "value": "postman-library",
                  "type": "text"
                },
                {
                  "key": "media_type",
                  "value": "book",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "finished",
                  "type": "text"
                },
                {
                  "key": "released_at",
                  "value": "2026-05-19",
                  "type": "text"
                },
                {
                  "key": "public_rating",
                  "value": "8",
                  "type": "text"
                },
                {
                  "key": "personal_rating",
                  "value": "9",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/library"
          }
        },
        {
          "name": "POST /library Create Entry With Local Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created library entry with image', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('image file was uploaded', function () {",
                  "  pm.expect(body.image_src, 'image_src').to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.id) {",
                  "  pm.environment.set('imageEntryId', body.id);",
                  "}",
                  "if (body.image_src) {",
                  "  pm.environment.set('imageSrc', body.image_src);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman Local Image Entry",
                  "type": "text"
                },
                {
                  "key": "media_id",
                  "value": "postman-local-image",
                  "type": "text"
                },
                {
                  "key": "media_type",
                  "value": "movie",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "planning",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "/Users/nikaqvrivishvili/projects/metavault/packages/web-client/src/assets/Meta.png"
                }
              ]
            },
            "url": "{{baseUrl}}/library"
          }
