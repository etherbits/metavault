        {
          "name": "POST /library Create Entry With Local Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created library entry with image', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('image file was uploaded', function () {",
                  "  pm.expect(body.image_src, 'image_src').to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.id) {",
                  "  pm.environment.set('imageEntryId', body.id);",
                  "}",
                  "if (body.image_src) {",
                  "  pm.environment.set('imageSrc', body.image_src);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
