{
  "info": {
    "_postman_id": "4c3b31a3-d4ef-4635-a709-f0ee06acb23d",
    "name": "MetaVault API",
    "description": "Local API checks for auth, EZQ, and library import/export. Start with Auth / Sign In Seeded User so Postman stores the access_token cookie for protected requests. For sign-up verification, copy the OTP from server logs or the database into the otpCode environment variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is not a server error', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/sign-up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Math.floor(Date.now() / 1000);",
                  "pm.environment.set('signupEmail', `postman+${suffix}@test.local`);",
                  "pm.environment.set('signupUsername', `pm_${suffix}`);",
                  "pm.environment.unset('otpCode');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"username\": \"{{signupUsername}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-up"
          }
        },
        {
          "name": "POST /auth/verify-user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"otpCode\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-user"
          }
        },
        {
          "name": "POST /auth/resend-verification-code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-verification-code"
          }
        },
        {
          "name": "POST /auth/sign-in Seeded User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.user && body.user.id) {",
                  "  pm.environment.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-in"
          }
        },
        {
          "name": "POST /auth/sign-in New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{signupUsername}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-in"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "EZQ",
      "item": [
        {
          "name": "POST /ezq Create First Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created entry', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const rows = pm.response.json().rows || [];",
                  "if (rows[0] && rows[0].id) {",
                  "  pm.environment.set('entryId', rows[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"/create postman_first_entry tg:postman\"\n}"
            },
            "url": "{{baseUrl}}/ezq"
          }
        },
        {
          "name": "POST /ezq Create Second Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json().rows || [];",
                  "if (rows[0] && rows[0].id) {",
                  "  pm.environment.set('secondEntryId', rows[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"/create postman_second_entry tg:postman tg:export\"\n}"
            },
            "url": "{{baseUrl}}/ezq"
          }
        },
        {
          "name": "POST /ezq Search All",
          "request": {
            "method": "POST",
            "header": [
