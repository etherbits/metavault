    {
      "name": "Content Nodes",
      "item": [
        {
          "name": "POST /content-nodes Create By Entry ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created content node', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) pm.environment.set('contentNodeId', body.id);",
                  "if (body.library_entry_id) pm.environment.set('contentNodeLibraryEntryId', body.library_entry_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Content Node 1\",\n  \"link\": \"https://example.com/watch/postman-1\",\n  \"library_entry_id\": \"{{libraryEntryId}}\"\n}"
            },
            "url": "{{baseUrl}}/content-nodes"
          }
        },
