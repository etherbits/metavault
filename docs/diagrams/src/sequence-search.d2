shape: sequence_diagram

user: User
client: "Browser (React)"
ezq_engine: "EZQ Engine"
api: "MetaVault API"
ezq_service: "EZQ Service"
delegator: "Command Delegator"
db: "SQLite"
sources: "Source APIs"

user -> client: "write EZQ query"
client -> ezq_engine: "generate_ast(rawQuery)"
ezq_engine -> client: "{ ast, canonical, errors }"
client -> client: "show inline feedback"

user -> client: "run query"
client -> api: "POST /ezq { query }"
api -> ezq_service: "execute(query, { user_id })"
ezq_service -> ezq_engine: "generate_ast(query)"
ezq_engine -> ezq_service: "ast"
ezq_service -> ezq_engine: "generate_sql(ast, extras)"
ezq_engine -> ezq_service: "SQL steps and commands"
ezq_service -> db: "run search, create, update, or delete"
db -> ezq_service: "rows"

ezq_service -> delegator: "delegate #alias, #pull, #enrich"
delegator -> db: "read aliases, catalogue, and settings"
delegator -> sources: "fetch metadata for #enrich"
sources -> delegator: "metadata"
delegator -> db: "create or update rows when needed"
delegator -> ezq_service: "final rows"

ezq_service -> api: "{ rows }"
api -> client: "200 OK { rows }"
client -> user: "render result grid"
