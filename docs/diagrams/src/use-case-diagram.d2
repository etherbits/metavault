direction: right

user: User { shape: person }

sources: Source APIs {
  igdb: IGDB
  openlibrary: OpenLibrary
  tmdb: TMDB
  anilist: AniList
}

ai: AI Service { shape: rectangle }

system: MetaVault {
  auth: Authentication {
    grid-columns: 2
    register: Register { shape: oval }
    verify: Verify Account { shape: oval }
    login: Login { shape: oval }
    logout: Logout { shape: oval }
  }
  library: Library {
    grid-columns: 4
    add: Add Entries { shape: oval }
    update: Update Entries { shape: oval }
    delete: Delete Entries { shape: oval }
    search: Search Entries { shape: oval }
    import: Import Media { shape: oval }
    export: Export Media { shape: oval }
  }
  integrations: Integrations {
    grid-columns: 2
    toggle_source: Toggle Source Integration { shape: oval }
    toggle_ai: Toggle AI Integration { shape: oval }
  }
  ai_chat: AI Chat { shape: oval }
}

# User interacts with each feature group
user -> system.auth
user -> system.library
user -> system.integrations
user -> system.ai_chat

# Collapse the source connections to the container level
# to prevent the layout engine from exploding
system.library -> sources
system.integrations.toggle_source -> sources
system.ai_chat -> ai
system.integrations.toggle_ai -> ai
