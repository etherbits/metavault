shape: sequence_diagram

user: User
client: "Browser (React)"
api: "MetaVault API"
auth: "Auth Service"
db: "SQLite"
mail: "SMTP Server"

user -> client: "submit sign-up form"
client -> api: "POST /auth/sign-up { email, username, password }"
api -> auth: "signUp(input)"
auth -> db: "SELECT user by email"
db -> auth: "null (not found)"
auth -> auth: "argon2id hash"
auth -> db: "INSERT user"
auth -> auth: "generate 6-digit OTP"
auth -> db: "INSERT otp_codes"
auth -> mail: "send verification email"
mail -> auth: "delivered"
auth -> api: "ok({ message })"
api -> client: "200 OK"
client -> user: "redirect to /verify"

user -> client: "enter OTP"
client -> api: "POST /auth/verify-user { email, otpCode }"
api -> auth: "verifyUser(input)"
auth -> db: "SELECT user, validate OTP"
db -> auth: "user, otp"
auth -> db: "UPDATE users SET is_verified=1"
auth -> db: "DELETE otp"
auth -> mail: "send welcome email"
auth -> api: "ok({ message })"
api -> client: "200 OK"
client -> user: "redirect to /sign-in"
